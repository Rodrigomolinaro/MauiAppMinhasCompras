<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.ListaProduto"
             Title="Minhas Compras">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Somar" Clicked="ToolbarItem_Clicked_1"/>
        <ToolbarItem Text="Adicionar" Clicked="ToolbarItem_Clicked" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Label">
                <Setter Property="VerticalTextAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- RowDefinitions atualizado para 4 linhas: Busca, Filtro, Relatório e Lista -->
    <Grid RowDefinitions="Auto, Auto, Auto, *">

        <!-- Linha 0: Busca -->
        <SearchBar x:Name="txt_search" 
                   Margin="-15, 0, 0, 0"
                   Placeholder="Busca de Produtos"
                   TextChanged="txt_search_TextChanged"
                   Grid.Row="0"/>

        <!-- Linha 1: Filtro -->
        <HorizontalStackLayout Spacing="10" Padding="10" Grid.Row="1">
            <Picker x:Name="pckFiltroCategoria" Title="Filtrar por Categoria" HorizontalOptions="FillAndExpand" SelectedIndexChanged="pckFiltroCategoria_SelectedIndexChanged">
                <Picker.Items>
                    <x:String>Todos</x:String>
                    <x:String>Alimentos</x:String>
                    <x:String>Higiene</x:String>
                    <x:String>Limpeza</x:String>
                    <x:String>Outros</x:String>
                </Picker.Items>
            </Picker>
        </HorizontalStackLayout>

        <!-- Linha 2: Área do Relatório -->
        <Frame Padding="10" Margin="10" BackgroundColor="#E8F5E9" CornerRadius="8" Grid.Row="2">
            <VerticalStackLayout>
                <Label Text="Total Gasto por Categoria" FontAttributes="Bold" FontSize="16" />
                <CollectionView x:Name="cvRelatorioCategoria">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <HorizontalStackLayout Spacing="15">
                                <Label Text="{Binding Categoria}" FontAttributes="Bold" />
                                <Label Text="{Binding TotalGasto, StringFormat='R$ {0:F2}'}" TextColor="DarkGreen"/>
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Frame>

        <!-- Linha 3: Lista de Produtos (Muda para Grid.Row="3" e o tamanho da linha para "*") -->
        <ListView x:Name="lst_produtos" 
                  IsPullToRefreshEnabled="True"
                  Refreshing="lst_produtos_Refreshing"
                  ItemSelected="lst_produtos_ItemSelected"
                  Grid.Row="3" >
            <ListView.Header>
                <Grid ColumnDefinitions="30, 100, 80, 50, 90" BackgroundColor="#E1E1E1">
                    <Label Grid.Column="0" Text="Id" Padding="5" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="Descrição" FontAttributes="Bold" />
                    <Label Grid.Column="2" Text="Preço" FontAttributes="Bold" />
                    <Label Grid.Column="3" Text="Qnt" FontAttributes="Bold" />
                    <Label Grid.Column="4" Text="Total" FontAttributes="Bold" />
                </Grid>
            </ListView.Header>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <ViewCell.ContextActions>
                            <MenuItem Text="Remove" Clicked="MenuItem_Clicked"/>
                        </ViewCell.ContextActions>
                        <Grid ColumnDefinitions="30, 100, 80, 50, 90">
                            <Label Grid.Column="0" Text="{Binding Id}" Padding="5"/>
                            <Label Grid.Column="1" Text="{Binding Descricao}" />
                            <Label Grid.Column="2" Text="{Binding Preco,StringFormat='{}{0:c}'}" />
                            <Label Grid.Column="3" Text="{Binding Quantidade}" />
                            <Label Grid.Column="4" Text="{Binding Total, StringFormat='{}{0:c}'}" />
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </Grid>
</ContentPage>